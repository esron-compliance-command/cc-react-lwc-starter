<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <!-- lightningCommunity__Page (a page region's own config) does not support <property> at
             all; only lightningCommunity__Default, the component's Experience Builder property
             panel, does. Getting this wrong is a deploy error with an unhelpful message. -->
        <targetConfig targets="lightningCommunity__Default">
            <property name="objectApiName" type="String" label="Object API Name" default="Account" />
            <property name="caption" type="String" label="List Caption" default="Accounts" />
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="objectApiName" type="String" label="Object API Name" default="Account" />
            <property name="caption" type="String" label="List Caption" default="Accounts" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
